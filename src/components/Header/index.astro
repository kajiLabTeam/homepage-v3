---
import { Image } from 'astro:assets';
import HamburgerMenu from './HamburgerMenu.astro';
import DropDown from '../DropDown/index.astro';
import { getPages, getResearchProjects } from '@/utils/content';

export interface Path {
  link: string;
  page: string;
}

const paths: Path[] = [
  { page: 'home', link: '/' },
  ...(await getPages({ withHidden: false })).map(({ data }) => ({ link: data.link, page: data.tags.page })),
  { page: 'posts', link: '/posts' },
];
const projects = await getResearchProjects();
---

<header>
  <nav>
    <div class:list={['container', 'logo']}>
      <a href="/">
        <Image
          src="/img/kaji_original.webp"
          alt="これは何の生物でしょうか？ → コンソールにて `whatCreature()`"
          height="40"
          width="40"
          densities={[2]}
        />
        <h1 class="title">Kaji Lab</h1>
      </a>
    </div>

    <div class:list={['container', 'links']}>
      <div class="link-list">
        {
          paths.map((path) =>
            path.page === 'research' ? (
              <DropDown label="カテゴリー">
                <span class="link" slot="trigger">
                  {path.page}
                </span>

                <a href={path.link}>Projects</a>
                {projects.map((project) => (
                  <a href={`/research/${project.toLowerCase()}`}>- {project}</a>
                ))}
              </DropDown>
            ) : (
              <a class="link" href={path.link}>
                {path.page}
              </a>
            ),
          )
        }
      </div>
    </div>

    <HamburgerMenu class="hamburger" paths={paths} />
  </nav>
</header>

<script>
  declare global {
    interface Window {
      whatCreature: Function;
    }
  }

  window.whatCreature = () => {
    window.location.href = '/mogura';
  };
</script>

<style lang="scss">
  header {
    padding: 0 20px;
    height: $header-height;
    background-color: $color-bg;
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    box-shadow: $shadow-header;

    nav {
      height: 100%;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;

      .container {
        height: 100%;
        display: flex;
        align-items: center;
        gap: 15px;

        &.logo {
          min-width: 150px;

          a {
            display: contents;
            color: $color-text;
          }
        }

        &.links {
          min-width: 0;
          flex: 1;
          justify-content: flex-end;
        }

        @include mobile {
          &.links {
            display: none;
          }
        }

        .link-list {
          min-width: 0;
          display: flex;
          align-items: center;
          gap: 15px;
        }

        .title {
          font-size: 1.2rem;
        }

        .link {
          color: $color-primary;
          text-transform: capitalize;
        }

        :global(.dropdown) {
          flex-shrink: 0;
        }
      }

      .hamburger {
        display: none;

        @include mobile {
          display: block;
        }
      }
    }
  }
</style>
