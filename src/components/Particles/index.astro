const monthParticles: Record<number, ILoadParams['options']> = {
  1: particles.snow,
  2: particles.snow,
  3: particles.sakura,
  4: particles.sakura,
  5: particles.leaf,
  6: particles.rain,
  7: particles.fireworks,
  8: particles.fireworks,
  9: particles.fireworks,
  10: particles.momiji,
  11: particles.momiji,
  12: particles.snow,
};
const month = new Date().getMonth() + 1;

const selectedParticle: ILoadParams['options'] = particle ? particles[particle] : monthParticles[month];
---

<script>
  import { type Engine } from '@tsparticles/engine';
  import { tsParticles, type ILoadParams } from '@tsparticles/engine';
  import { loadFireworksPreset } from '@tsparticles/preset-fireworks';
  import { loadAll } from '@tsparticles/all';

  declare global {
    interface Window {
      particlesInit: (engine: Engine) => Promise<void>;
    }
  }

  window.addEventListener('DOMContentLoaded', () => {
    (async () => {
      const selectedParticle: ILoadParams['options'] = JSON.parse(
        document.getElementById('particle')?.getAttribute('data-particle-options') || '{}',
      );

      await loadFireworksPreset(tsParticles);
      await loadAll(tsParticles);

      await tsParticles.load({
        id: 'particle',
        options: selectedParticle,
      });

      const particles = tsParticles.domItem(0);
      particles?.play();
    })();
  });
</script>

<div id="particle" data-particle-options={JSON.stringify(selectedParticle)}></div>

<style lang="scss" is:global>
  [data-id='particle'] {
    display: none;
  }

  #particle {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
  }
</style>
